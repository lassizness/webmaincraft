YII_ENV=prod
YII_DEBUG=0
APP_NAME=HiveTech
APP_URL=https://hivetech.example
ADMIN_URL=https://admin.hivetech.example
COOKIE_DOMAIN=.hivetech.example
COOKIE_VALIDATION_KEY=CHANGE_ME_LONG_RANDOM_STRING

HIVETECH_DB_HOST=10.140.0.142
HIVETECH_DB_PORT=3306
HIVETECH_DB_NAME=hivetech_core
HIVETECH_WEB_DB_USER=hivetech_web
HIVETECH_WEB_DB_PASSWORD=CHANGE_ME

# Migrations use a privileged account. Leave blank in the web runtime env.
HIVETECH_MIGRATION_DB_USER=root
HIVETECH_MIGRATION_DB_PASSWORD=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
MAIL_FROM=no-reply@hivetech.example
MAIL_FROM_NAME=HiveTech

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

FORUM_URL=
FORUM_SSO_SECRET=

# Voting callbacks. VOTE_TRUSTED_PROXY_IPS is a comma-separated list of reverse proxies that may set X-Forwarded-For.
VOTE_TRUSTED_PROXY_IPS=10.254.254.1

# Optional Minecraft RCON secrets, selected by servers.rcon_env_key.
MINECRAFT_RCON_MAIN_HOST=127.0.0.1
MINECRAFT_RCON_MAIN_PORT=25575
MINECRAFT_RCON_MAIN_PASSWORD=
