    display: inline-flex;
    gap: 4px;
    padding: 5px;
    border: 1px solid rgba(255,255,255,.10);
    border-radius: 12px;
    background: rgba(255,255,255,.035);
}

.privilege-duration-btn {
    border: 0;
    border-radius: 8px;
    padding: 9px 16px;
    background: transparent;
    color: rgba(255,255,255,.65);
    font-weight: 600;
    transition: .15s ease;
}

.privilege-duration-btn:hover {
    color: #fff;
    background: rgba(255,255,255,.06);
}

.privilege-duration-btn.active {
    color: #fff;
    background: rgba(255,255,255,.13);
}

.privilege-card {
    display: flex;
    flex-direction: column;
    min-height: 250px;
}

.privilege-card-head {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    align-items: flex-start;
}

.privilege-card-head h3 {
    margin-bottom: 0;
}

.privilege-days {
    white-space: nowrap;
    padding: 5px 9px;
    border-radius: 8px;
    background: rgba(255,255,255,.07);
    color: rgba(255,255,255,.7);
    font-size: 13px;
}

.privilege-description {
    margin-top: 18px;
    flex: 1;
}

.privilege-card-bottom {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-top: 20px;
}

.privilege-price {
    font-size: 24px;
    line-height: 1.1;
    font-weight: 700;
    margin-top: 3px;
}

@media (max-width: 700px) {

    .privilege-duration-toggle {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        width: 100%;
    }

    .privilege-duration-btn {
        width: 100%;
    }
}

</style>


<script>

document.addEventListener('DOMContentLoaded', function () {

    const toggle = document.querySelector(
        '[data-privilege-duration-toggle]'
    );

    if (!toggle) {
        return;
    }

    const buttons = toggle.querySelectorAll(
        '[data-duration]'
    );

    const cards = document.querySelectorAll(
        '[data-privilege-card]'
    );

    function formatPrice(value) {

        return new Intl.NumberFormat(
            'ru-RU',
            {
                maximumFractionDigits: 2
            }
        ).format(value) + ' ₽';

    }


    function selectDuration(days) {

        buttons.forEach(function (button) {

            button.classList.toggle(
                'active',
                Number(button.dataset.duration) === days
            );

        });


        cards.forEach(function (card) {

            const variants = JSON.parse(
                card.dataset.variants
            );

            const variant = variants[String(days)];

            const price = card.querySelector(
                '[data-price]'
            );

            const selectedDays = card.querySelector(
                '[data-selected-days]'
            );

            const form = card.querySelector(
                '[data-buy-form]'
            );

            const buyButton = card.querySelector(
                '[data-buy-button]'
            );


            if (!variant) {

                card.classList.add(
                    'privilege-unavailable'
                );

                if (buyButton) {
                    buyButton.disabled = true;
                    buyButton.textContent = 'Недоступно';
                }

                return;
            }


            card.classList.remove(
                'privilege-unavailable'
            );


            if (price) {
                price.textContent = formatPrice(
                    variant.price
                );
            }


            if (selectedDays) {
                selectedDays.textContent =
                    days + ' дней';
            }


            if (form) {
                form.action = variant.url;
            }


            if (buyButton) {
                buyButton.disabled = false;
                buyButton.textContent = 'Купить';
            }

        });

    }


    buttons.forEach(function (button) {

        button.addEventListener(
            'click',
            function () {

                selectDuration(
                    Number(button.dataset.duration)
                );

            }
        );

    });

});

</script>
