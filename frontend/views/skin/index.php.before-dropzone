<script>

(function()
{
    const canvas =
        document.getElementById(
            'skin-character'
        );

    const ctx =
        canvas.getContext('2d');

    ctx.imageSmoothingEnabled = false;


    function draw(
        img,
        sx, sy,
        sw, sh,
        dx, dy,
        dw, dh
    )
    {
        ctx.drawImage(
            img,
            sx,
            sy,
            sw,
            sh,
            dx,
            dy,
            dw,
            dh
        );
    }


    function renderSkin(img)
    {
        ctx.clearRect(
            0,
            0,
            canvas.width,
            canvas.height
        );

        const modern =
            img.naturalHeight >= 64;


        draw(
            img,
            8, 8,
            8, 8,
            30, 0,
            60, 60
        );


        draw(
            img,
            40, 8,
            8, 8,
            30, 0,
            60, 60
        );


        draw(
            img,
            20, 20,
            8, 12,
            30, 60,
            60, 90
        );


        draw(
            img,
            44, 20,
            4, 12,
            0, 60,
            30, 90
        );


        draw(
            img,
            modern ? 36 : 44,
            modern ? 52 : 20,
            4, 12,
            90, 60,
            30, 90
        );


        draw(
            img,
            4, 20,
            4, 12,
            30, 150,
            30, 90
        );


        draw(
            img,
            modern ? 20 : 4,
            modern ? 52 : 20,
            4, 12,
            60, 150,
            30, 90
        );
    }


    const skinSheet =
        document.getElementById(
            'skin-sheet'
        );


    if(
        skinSheet
        && skinSheet.src
        && skinSheet.getAttribute('src')
    )
    {
        if(skinSheet.complete)
        {
            renderSkin(skinSheet);
        }
        else
        {
            skinSheet.addEventListener(
                'load',
                function()
                {
                    renderSkin(
                        skinSheet
                    );
                }
            );
        }
    }


    document
        .getElementById('skin-file')
        .addEventListener(
            'change',
            function()
            {
                const file =
                    this.files[0];

                if(!file)
                {
                    return;
                }

                const url =
                    URL.createObjectURL(
                        file
                    );

                const image =
                    new Image();

                image.onload =
                    function()
                    {
                        renderSkin(
                            image
                        );

                        skinSheet.src =
                            url;

                        skinSheet
                            .parentElement
                            .style
                            .display =
                                'flex';

                        const empty =
                            document
                                .getElementById(
                                    'skin-empty'
                                );

                        if(empty)
                        {
                            empty.style.display =
                                'none';
                        }
                    };

                image.src = url;
            }
        );


    document
        .getElementById('cloak-file')
        .addEventListener(
            'change',
            function()
            {
                const file =
                    this.files[0];

                if(!file)
                {
                    return;
                }

                const preview =
                    document
                        .getElementById(
                            'cloak-preview'
                        );

                preview.src =
                    URL.createObjectURL(
                        file
                    );

                preview.style.display =
                    '';

                const empty =
                    document
                        .getElementById(
                            'cloak-empty'
                        );

                if(empty)
                {
                    empty.style.display =
                        'none';
                }
            }
        );

})();

</script>
