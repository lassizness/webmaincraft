<script>

(function()
{
    const form =
        document.getElementById(
            'texture-form'
        );

    const status =
        document.getElementById(
            'upload-status'
        );


    function setStatus(text)
    {
        status.textContent = text;
    }


    function validateFile(file)
    {
        if(!file)
        {
            return false;
        }

        if(
            file.type !== 'image/png'
            && !file.name
                .toLowerCase()
                .endsWith('.png')
        )
        {
            alert(
                'Можно загрузить только PNG.'
            );

            return false;
        }

        return true;
    }


    function submitFile(
        input,
        file,
        zone
    )
    {
        if(!validateFile(file))
        {
            return;
        }

        const transfer =
            new DataTransfer();

        transfer.items.add(file);

        input.files =
            transfer.files;

        zone.classList.add(
            'uploading'
        );

        setStatus(
            'Загрузка файла...'
        );

        form.submit();
    }


    function initDropZone(zone)
    {
        const input =
            document.getElementById(
                zone.dataset.input
            );


        zone.addEventListener(
            'click',
            function(event)
            {
                if(
                    event.target.closest(
                        '[data-drop-ignore]'
                    )
                )
                {
                    return;
                }

                input.click();
            }
        );


        input.addEventListener(
            'change',
            function()
            {
                const file =
                    input.files[0];

                if(file)
                {
                    submitFile(
                        input,
                        file,
                        zone
                    );
                }
            }
        );


        zone.addEventListener(
            'dragenter',
            function(event)
            {
                event.preventDefault();

                zone.classList.add(
                    'dragging'
                );
            }
        );


        zone.addEventListener(
            'dragover',
            function(event)
            {
                event.preventDefault();

                event.dataTransfer
                    .dropEffect =
                        'copy';

                zone.classList.add(
                    'dragging'
                );
            }
        );


        zone.addEventListener(
            'dragleave',
            function(event)
            {
                if(
                    !zone.contains(
                        event.relatedTarget
                    )
                )
                {
                    zone.classList.remove(
                        'dragging'
                    );
                }
            }
        );


        zone.addEventListener(
            'drop',
            function(event)
            {
                event.preventDefault();

                zone.classList.remove(
                    'dragging'
                );

                const file =
                    event
                        .dataTransfer
                        .files[0];

                if(file)
                {
                    submitFile(
                        input,
                        file,
                        zone
                    );
                }
            }
        );
    }


    initDropZone(
        document.getElementById(
            'skin-drop'
        )
    );

    initDropZone(
        document.getElementById(
            'cloak-drop'
        )
    );


    /*
     * Простое фронтальное preview скина.
     */

    const canvas =
        document.getElementById(
            'skin-character'
        );

    const ctx =
        canvas.getContext('2d');

    ctx.imageSmoothingEnabled =
        false;


    function part(
        image,
        sx,
        sy,
        sw,
        sh,
        dx,
        dy,
        dw,
        dh
    )
    {
        ctx.drawImage(
            image,
            sx,
            sy,
            sw,
            sh,
            dx,
            dy,
            dw,
            dh
        );
    }


    function renderSkin(image)
    {
        ctx.clearRect(
            0,
            0,
            canvas.width,
            canvas.height
        );

        const modern =
            image.naturalHeight >= 64;


        // Голова
        part(
            image,
            8,8,8,8,
            37,0,76,76
        );


        // Шапка / второй слой головы
        part(
            image,
            40,8,8,8,
            37,0,76,76
        );


        // Тело
        part(
            image,
            20,20,8,12,
            37,76,76,112
        );


        // Правая рука
        part(
            image,
            44,20,4,12,
            0,76,37,112
        );


        // Левая рука
        part(
            image,
            modern ? 36 : 44,
            modern ? 52 : 20,
            4,12,
            113,76,37,112
        );


        // Правая нога
        part(
            image,
            4,20,4,12,
            37,188,38,112
        );


        // Левая нога
        part(
            image,
            modern ? 20 : 4,
            modern ? 52 : 20,
            4,12,
            75,188,38,112
        );
    }


    <?php if($hasSkin): ?>

    const currentSkin =
        new Image();

    currentSkin.onload =
        function()
        {
            renderSkin(
                currentSkin
            );
        };

    currentSkin.src =
        <?= json_encode(
            $skinUrl,
            JSON_UNESCAPED_SLASHES
        ) ?>;

    <?php endif; ?>

})();

</script>
